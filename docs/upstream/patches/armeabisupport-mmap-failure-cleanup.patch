+/* Best effort, errors ignored (this is the clean-up after an error): for every page of the range, unmap it if it is mapped and release it.  Releasing a page that was never claimed is an error
+ * of the OS call, which is ignored; that way nothing depends on how the OS reports a claimed page.  */
+static void
+allocator_mmap_rollback(armeabisupport_allocator_mmap *allocator, int page, size_t num_pages)
+{
+  while (num_pages--)
+    {
+      pmp_page_info_entry entry;
+      int page_entry[3];
+
+      entry.pmp_page_index = page;
+      entry.physical_page_number = -1;
+      entry.da_page_number = -1;
+      entry.flags = 0;
+      if (dynamic_pmp_page_info(allocator->base.da.number, &entry, 1) == NULL
