--- a/gcc4/recipe/files/gcc/libunixlib/incl-local/internal/unix.h
+++ b/gcc4/recipe/files/gcc/libunixlib/incl-local/internal/unix.h
@@ -432,6 +432,36 @@
 
 extern unsigned int __get_cpu_arch (void);
 
+/* The pages of an EABI stack are mapped one at a time, by ARMEABISupport's data abort handler, when a page is first touched.  If the first access to a page comes from
+   RISC OS itself, in supervisor mode, while it fills a buffer for the caller (OS_GBPB, the socket calls, ...), the store that takes the fault is lost: some bytes of the
+   buffer are never written (seen on a Cortex-A72 machine with RISC OS 5: the 8 or 16 bytes before most page boundaries of a read into a big stack buffer that had not
+   been used yet).  A load in user mode maps the page properly, so touch every page of a buffer that lies on this thread's stack (within 1 MB above the stack pointer)
+   before handing it to the OS.  Buffers anywhere else (heap, mmap, static) are left alone: touching them would only commit memory.  */
+#if defined (__ARM_EABI__)
+static inline void
+__touch_stack_buffer (const void *__buf, size_t __n)
+{
+  unsigned int __sp, __lo = (unsigned int) __buf, __hi;
+
+  __asm__ ("mov	%0, sp" : "=r" (__sp));
+  if (__lo - __sp >= 0x100000u)
+    return;
+  __hi = __lo + (unsigned int) __n;
+  if (__hi < __lo || __hi - __sp > 0x100000u)
+    __hi = __sp + 0x100000u;
+  for (volatile const char *__p = (volatile const char *) (__lo & ~0xfffu);
+       (unsigned int) __p < __hi; __p += 4096)
+    (void) *__p;
+}
+#else
+static inline void
+__touch_stack_buffer (const void *__buf, size_t __n)
+{
+  (void) __buf;
+  (void) __n;
+}
+#endif
+
 __END_DECLS
 
 #endif
