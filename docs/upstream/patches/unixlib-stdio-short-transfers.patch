@@ -77,6 +77,9 @@
 		  break;
 		}
 	      to_write -= bytes;
+	      /* write () may take fewer bytes than it was given: carry on
+		 after them, do not write the same bytes again.  */
+	      data = (const void *)((const char *)data + bytes);
 	      /* Increment the internal file offset.  */
 	      stream->__offset += bytes;
 	      total_bytes += bytes;
@@ -172,6 +175,7 @@
