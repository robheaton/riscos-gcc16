--- a/libgcc/Makefile.in	2026-10-06 08:23:17.412181157 +0100
+++ b/libgcc/Makefile.in	2026-10-06 08:23:17.423355925 +0100
@@ -905,6 +905,12 @@
 -include $(iterator)
 
 # Build libgcov components.
+#
+# libgcov writes the .gcda files with the C library, so it must not be built with -Dinhibit_libc: a cross compiler that is configured without --with-sysroot or
+# --with-headers (the RISC OS one is) passes it to every libgcc object, and libgcov then contains no __gcov_exit, no __gcov_indirect_call ...  Programs built with
+# --coverage or -fprofile-generate did not link.  The headers of the target are installed before libgcc is built.
+libgcov_compile = $(filter-out -Dinhibit_libc,$(gcc_compile))
+
 
 LIBGCOV_MERGE = _gcov_merge_add _gcov_merge_topn			\
 	_gcov_merge_ior _gcov_merge_time_profile
@@ -934,14 +940,14 @@
                  $(libgcov-interface-objects) $(libgcov-driver-objects)
 
 $(libgcov-merge-objects): %$(objext): $(srcdir)/libgcov-merge.c $(srcdir)/gcov.h $(srcdir)/libgcov.h
-	$(gcc_compile) -DL$* -c $(srcdir)/libgcov-merge.c
+	$(libgcov_compile) -DL$* -c $(srcdir)/libgcov-merge.c
 $(libgcov-profiler-objects): %$(objext): $(srcdir)/libgcov-profiler.c $(srcdir)/gcov.h $(srcdir)/libgcov.h
-	$(gcc_compile) -DL$* -c $(srcdir)/libgcov-profiler.c
+	$(libgcov_compile) -DL$* -c $(srcdir)/libgcov-profiler.c
 $(libgcov-interface-objects): %$(objext): $(srcdir)/libgcov-interface.c $(srcdir)/gcov.h $(srcdir)/libgcov.h
-	$(gcc_compile) -DL$* -c $(srcdir)/libgcov-interface.c
+	$(libgcov_compile) -DL$* -c $(srcdir)/libgcov-interface.c
 $(libgcov-driver-objects): %$(objext): $(srcdir)/libgcov-driver.c \
   $(srcdir)/libgcov-driver-system.c $(srcdir)/gcov.h $(srcdir)/libgcov.h
-	$(gcc_compile) -DL$* -c $(srcdir)/libgcov-driver.c
+	$(libgcov_compile) -DL$* -c $(srcdir)/libgcov-driver.c
 
 
 # Static libraries.
