+#if !defined (__riscos__) && !defined (__riscos)
+/* RISC OS style include names, "Prefix:Name.h" (DeskLib:Core.h, as the GCCSDK cross compiler of 4.7.4 read them): on RISC OS itself FileSwitch resolves Prefix: through the system
+   variable Prefix$Path, so this is only for a cross compiler on another system.  The prefix is a RISC OS name and its case is not significant.  The name is looked for
+     1. in the directories of the environment variable PREFIX_PATH (the prefix in upper case, the directories separated by commas; the first file that exists is used),
+     2. in the directories of the include path, in a directory called Prefix (any case) there (so a tool chain that has include/DeskLib/Core.h finds DeskLib:Core.h),
+   and the name of the file is matched in any case in 1 and 2 too (RISC OS names are not case sensitive: Colourtran.h is ColourTran.h).
+     3. else the prefix is dropped, and Name.h is searched like any other name (so -I<folder of DeskLib's headers> is enough).
+   Names without such a prefix are not touched.  FNAME is freed if a different name is returned.  */
+/* The entry of directory DIR whose name is NAME in any case (RISC OS names are not case sensitive), as a new string; NULL if there is none.  */
+static char *
+riscos_find_entry (const char *dir, const char *name)
+{
+  DIR *d = opendir (dir[0] ? dir : ".");
+  struct dirent *e;
+  char *res = NULL;
+  if (d == NULL)
+    return NULL;
+  while ((e = readdir (d)) != NULL)
+    if (strcasecmp (e->d_name, name) == 0)
+      {
+	res = xstrdup (e->d_name);
+	if (strcmp (e->d_name, name) == 0)
+	  break;			/* the exact spelling is the best */
+      }
+  closedir (d);
+  return res;
+}
+
+static char *
+riscos_expand_prefix (cpp_reader *pfile, char *fname)
+{
+  const char *colon = strchr (fname, ':');
+  const char *rest;
+  size_t plen, i;
+  char var[128];
+  const char *val;
+  cpp_dir *dir;
+  char *res;
+
+  if (colon == NULL || colon == fname || colon[1] == '\0' || colon[1] == '/')
+    return fname;
+  plen = (size_t) (colon - fname);
+  for (i = 0; i < plen; i++)
+    if (!ISALNUM ((unsigned char) fname[i]) && fname[i] != '_')
+      return fname;
+  rest = colon + 1;
+  if (plen + 6 > sizeof var)
+    return fname;
+  for (i = 0; i < plen; i++)
+    var[i] = TOUPPER ((unsigned char) fname[i]);
+  strcpy (var + plen, "_PATH");
+
+  val = getenv (var);
+  while (val != NULL && *val)
+    {
+      const char *end = strchr (val, ',');
+      size_t dlen = end ? (size_t) (end - val) : strlen (val);
+      if (dlen > 0)
+	{
+	  char *dn = XNEWVEC (char, dlen + 1);
+	  char *cand = NULL, *found;
+	  memcpy (dn, val, dlen);
+	  dn[dlen] = '\0';
+	  found = riscos_find_entry (dn, rest);	/* the name, in any case */
+	  if (found)
+	    {
+	      cand = XNEWVEC (char, dlen + strlen (found) + 2);
+	      sprintf (cand, "%s%s%s", dn, dn[dlen - 1] == '/' ? "" : "/", found);
+	      free (found);
+	    }
+	  free (dn);
+	  if (cand)
+	    {
+	      res = access (cand, R_OK) == 0 ? lrealpath (cand) : NULL;
+	      free (cand);
+	      if (res)
+		{
+		  free (fname);
+		  return res;
+		}
+	    }
+	}
+      val = end ? end + 1 : NULL;
+    }
+
+  for (dir = pfile->quote_include; dir; dir = dir->next)
+    {
+      const char *dn = dir->name[0] ? dir->name : ".";
+      DIR *d = opendir (dn);
+      struct dirent *e;
+      if (d == NULL)
+	continue;
+      while ((e = readdir (d)) != NULL)
+	if (strlen (e->d_name) == plen && strncasecmp (e->d_name, fname, plen) == 0)
+	  {
+	    size_t nl = strlen (e->d_name);
+	    char *sub = XNEWVEC (char, strlen (dn) + nl + 2);
+	    char *found;
+	    sprintf (sub, "%s/%s", dn, e->d_name);
+	    found = riscos_find_entry (sub, rest);
+	    free (sub);
+	    if (found)
+	      {
+		res = XNEWVEC (char, nl + strlen (found) + 2);
+		sprintf (res, "%s/%s", e->d_name, found);
+		free (found);
+		closedir (d);
+		free (fname);
+		return res;
+	      }
+	  }
+      closedir (d);
+    }
+
+  res = xstrdup (rest);
+  free (fname);
+  return res;
+}
+#endif
