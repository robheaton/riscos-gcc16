+# RISC OS (UnixLib): the pthread primitives accept PTHREAD_PROCESS_SHARED, but there is no memory shared between processes, so the
+# coarray shared-memory library (-fcoarray=shared) cannot work there: do not build it.
+case "$host" in
+  *-riscos*) enable_caf_shmem=false ;;
+esac
