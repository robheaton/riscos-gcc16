+	ADRL	r2, trace_sfx_t
+	BL	trace_puts
+	MOV	r0, r8
+	BL	trace_hex8
+	ADRL	r2, trace_sfx_p
+	BL	trace_puts
+	LDR	r0, trace_p
+	BL	trace_hex8
+	ADRL	r2, trace_sfx_g
+	BL	trace_puts
+	LDR	r0, trace_g
+	BL	trace_hex8
+	ADRL	r2, trace_sfx_c
+	BL	trace_puts
+	LDR	r0, trace_c
+	BL	trace_hex8
+	ADRL	r2, trace_sfx_h
+	BL	trace_puts
+	LDR	r0, trace_h
+	BL	trace_hex8
+	MOV	r3, #10
+	STRB	r3, [r1], #1
+	SUB	r5, r1, r4		@ r5 = length of the line
+	MOV	r0, #0xC0
+	ADRL	r1, trace_name
+	SWI	XOS_Find_T
+	BVS	tr_done
+	MOVS	r6, r0			@ r6 = handle
+	BEQ	tr_done
+	MOV	r0, #2
+	MOV	r1, r6
+	SWI	XOS_Args_T		@ r2 = extent
+	MOV	r0, #1
+	MOV	r1, r6
+	SWI	XOS_Args_T		@ pointer := extent
+	MOV	r0, #2
+	MOV	r1, r6
+	MOV	r2, r4
+	MOV	r3, r5
+	SWI	XOS_GBPB_T
+	MOV	r0, #0
+	MOV	r1, r6
+	SWI	XOS_Find_T		@ close
+tr_done:
+	ADRL	r0, trace_regs
+	LDMIA	r0, {r1-r12, sp, lr}
+	MOV	pc, lr
+
+	@ r2 = NUL terminated string, r1 = write pointer: the string is copied without its NUL, r1 advanced; corrupts r2, r3
+trace_puts:
+	LDRB	r3, [r2], #1
+	TEQ	r3, #0
+	STRNEB	r3, [r1], #1
+	BNE	trace_puts
+	MOV	pc, lr
+
+	@ r0 = value, r1 = write pointer: 8 hex digits, r1 advanced; corrupts r0, r2, r3, r7
+trace_hex8:
+	MOV	r7, #8
+tr_hex_loop:
+	MOV	r0, r0, ROR #28
