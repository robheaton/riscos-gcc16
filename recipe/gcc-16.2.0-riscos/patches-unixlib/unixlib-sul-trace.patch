+@ ---------------------------------------------------------------------------------------------------------------------------------------------------------
+@ TRACE (a debugging aid for the test builds only: assemble with -DSULTRACE).  TRACE "text", reg  appends the line
+@     text v=<reg> sp=<the caller's sp> ctx=<VFPSupport_ActiveContext> t=<monotonic time> p=<[0x8038]> g=<[[0x8038]]> c=<[0x8040]> h=<sum of the words 0x8000-0x80FF>      (all in hex)
+@ p, g, c, h describe the application space as it is at that moment: p is the word that PIC_LOAD reads (the runtime workspace: the pointer to the client's GOTT array), g what it points at (the GOT of the
+@ library with index 0: ffffffff when p cannot be read), c SOManager's client structure of this application space, h a checksum of the first 256 bytes (ELF header and runtime workspace).
+@ TRACESUM "text", base, size  logs the sum of the words [base, base+size) as the value (nothing summed when base is 0).
+@ to the file named in trace_name, with raw SWIs (OS_Find 0xC0 open for update, OS_Args 2 and 1 to go to the end, OS_GBPB 2, OS_Find 0 close), from a PRIVATE stack and a static save area: the code
+@ that calls it may have no valid sp (sul_exit after ARMEABISupport_StackOp FREE) and every register except the flags is preserved.  Not re-entrant (nothing here is: one task runs at a time).  The file
+@ must exist (*Create it first).  If a step left the IRQs masked, the NEXT trace write (it needs the network) would hang: the last line then names the last step that ran with IRQs on.
+@ ---------------------------------------------------------------------------------------------------------------------------------------------------------
+@ ADRFAR: ADR for a label that the TRACE code may have moved out of the range of a single ADR (two instructions in a SULTRACE build, the plain ADR otherwise: the normal module is unchanged).
+#ifdef SULTRACE
+	.macro	ADRFAR reg, lab
+	ADRL	\reg, \lab
+	.endm
+#else
+	.macro	ADRFAR reg, lab
+	ADR	\reg, \lab
+	.endm
+#endif
+#ifdef SULTRACE
+	.macro	TRACE text, reg=r0
+	STR	\reg, trace_val
+	STR	r0, trace_r0
+	STR	lr, trace_lr
+	ADR	r0, 98f
+	BL	sul_trace
+	B	99f
+98:	.asciz	"\text"
+	.align
+99:	LDR	r0, trace_r0
+	LDR	lr, trace_lr
+	.endm
+	.macro	TRACESUM text, base, size
+	STR	\base, trace_sum_a
+	STR	\size, trace_sum_n
+	TRACE	"\text", r0
+	.endm
+#else
+	.macro	TRACE text, reg=r0
+	.endm
+	.macro	TRACESUM text, base, size
+	.endm
+#endif
