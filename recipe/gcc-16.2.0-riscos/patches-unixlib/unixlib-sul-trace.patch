+	MOV	r0, r6
+	ADD	r1, r6, #4
+	SWI	XOS_ValidateAddress_T
+	BVS	tr_nog
+	LDRCC	r7, [r6]
+tr_nog:
+	STR	r7, trace_g
+	SWI	XVFPSupport_ActiveContext_T
+	MOVVS	r0, #-1
+	MOV	r12, r0			@ r12 = the active VFP context (-1 when VFPSupport is not there)
+	SWI	XOS_ReadMonotonicTime_T
+	MOV	r8, r0			@ r8 = time
+	LDR	r9, trace_val		@ r9 = value
+	ADRL	r4, trace_line		@ r4 = start of the line, r1 = write pointer
+	MOV	r1, r4
+	LDR	r2, trace_tag
+	BL	trace_puts
+	ADRL	r2, trace_sfx_v
