-   can proceed at any one time, and we can't have ints
-   disabled during the init_routine call.
-   If the init_routine is cancelled then the effect should
-   be as if pthread_once was never called. */
+/* An exception (C++ exceptions have to propagate through pthread_once, as
+   std::call_once relies on it) thrown by the init routine must have the same
+   effect.  The thread's cleanup handler list is not unwound with the stack,
+   so its entry for this call is removed here, before the stack frame holding
+   it goes away.  */
+struct once_guard
+{
+  pthread_once_t *control;
+  int armed;
+  struct __pthread_cleanup cleanup;   /* the thread's cleanup list entry; lives as long as the guard */
+};
+
+static void
+once_guard_cleanup (struct once_guard *guard)
+{
+  if (guard->armed)
+    {
+      __pthread_cleanup_pop ();
+      once_reset (guard->control);
+    }
+}
