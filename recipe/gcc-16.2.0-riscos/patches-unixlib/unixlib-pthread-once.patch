 #include <errno.h>
 #include <pthread.h>
 
+/* once_mutex only protects the state of the pthread_once_t objects, and
+   once_cond signals changes of that state.  It is NOT held while an
+   init routine runs.
+
+   The previous implementation held one mutex shared by every
+   pthread_once_t for the whole duration of the init routine.  An init
+   routine that blocks on another thread, which itself calls pthread_once
+   for a different pthread_once_t, then deadlocks.  The C++ library does
+   exactly that in std::async: future::get() runs
+   call_once (thread::join) while the asynchronous thread runs
+   call_once (set the result).
+
+   State of a pthread_once_t:
+     0 (PTHREAD_ONCE_INIT)  init routine has not run
+     ONCE_RUNNING           some thread is inside the init routine
+     ONCE_DONE              init routine has completed (as before)  */
+#define ONCE_DONE    1
+#define ONCE_RUNNING 2
+
 static pthread_mutex_t once_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t once_cond = PTHREAD_COND_INITIALIZER;
 
+/* The init routine did not complete: the effect must be as if pthread_once
+   was never called, so let another thread try.  */
+static void
+once_reset (pthread_once_t *once_control)
+{
+  pthread_mutex_lock (&once_mutex);
+  *once_control = 0;
+  pthread_cond_broadcast (&once_cond);
+  pthread_mutex_unlock (&once_mutex);
+}
 
-/* Cleanup handler for pthread_once */
+/* Cleanup handler for pthread_once: the init routine was cancelled, i.e.
+   it called pthread_exit () or the thread was cancelled.  */
 static void
