+#ifdef __ARM_EABI__
+	@ --- Executable Finalisation, part 1: the .fini_array functions ---
+	@ Register a function that calls the program's .fini_array functions at exit.  It is registered BEFORE the constructors below run, so that it runs
+	@ after the atexit () functions and the static destructors that they register (as in glibc).  See stdlib/atexit.c.
+	LDR	a1, [v2, #CRT1_FINI_ARRAY_START]
+	LDR	a2, [v2, #CRT1_FINI_ARRAY_END]
+	BL	__register_fini_array
+#endif
