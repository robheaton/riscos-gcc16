@@ -111,6 +139,151 @@
 	WORD	__ul_memory
 	DECLARE_FUNCTION fork
 
+#ifdef ULTRACE
+	.set	XOS_Find_T, 0x2000D
+	.set	XOS_Args_T, 0x20009
+	.set	XOS_GBPB_T, 0x2000C
+	.set	XOS_ReadMonotonicTime_T, 0x20042
+	.set	XVFPSupport_ActiveContext_T, 0x78EC6
+	.set	XOS_ValidateAddress_T, 0x2003A
+
+	@ entry: r0 = the text (NUL terminated), r1 = the value.  Preserves every register and the flags.
+	.global	__ul_trace
+	.protected __ul_trace		@ (calls from the C code of this library bind directly, not through the lazily bound PLT)
+	.type	__ul_trace, %function
+__ul_trace:
+ul_trace_local:
+	STMFD	sp!, {r0-r12, lr}
+	MRS	r10, APSR		@ r10 = the flags
+	ADD	r11, sp, #14*4		@ r11 = the caller's sp
+	SUB	sp, sp, #208		@ the line buffer (192 bytes) and four words: p, g, c, h
+	MOV	r0, #0x8000
+	LDR	r6, [r0, #0x38]		@ r6 = p
+	STR	r6, [sp, #192]
+	LDR	r1, [r0, #0x40]
+	STR	r1, [sp, #200]		@ c
+	MOV	r2, r0
+	MOV	r3, #0
+	ADD	r4, r0, #0x100
+ul_tr_hloop:
+	LDR	r5, [r2], #4
+	ADD	r3, r3, r5
+	TEQ	r2, r4
+	BNE	ul_tr_hloop
+	STR	r3, [sp, #204]		@ h
+	MVN	r7, #0			@ g = ffffffff when [p] cannot be read
+	MOV	r0, r6
+	ADD	r1, r6, #4
+	SWI	XOS_ValidateAddress_T
+	BVS	ul_tr_nog
+	LDRCC	r7, [r6]
+ul_tr_nog:
+	STR	r7, [sp, #196]		@ g
+	SWI	XVFPSupport_ActiveContext_T
+	MOVVS	r0, #-1
+	MOV	r12, r0			@ r12 = the active VFP context (-1 when VFPSupport is not there)
+	SWI	XOS_ReadMonotonicTime_T
+	MOV	r8, r0			@ r8 = time
+	LDR	r9, [sp, #208+4]	@ r9 = the value (the saved r1)
+	MOV	r4, sp			@ r4 = start of the line, r1 = write pointer
+	MOV	r1, sp
+	LDR	r2, [sp, #208]		@ the text (the saved r0)
+	BL	ul_trace_puts
+	ADRL	r2, ul_sfx_v
+	BL	ul_trace_puts
+	MOV	r0, r9
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_sp
+	BL	ul_trace_puts
+	MOV	r0, r11
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_ctx
+	BL	ul_trace_puts
+	MOV	r0, r12
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_t
+	BL	ul_trace_puts
+	MOV	r0, r8
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_p
+	BL	ul_trace_puts
+	LDR	r0, [sp, #192]
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_g
+	BL	ul_trace_puts
+	LDR	r0, [sp, #196]
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_c
+	BL	ul_trace_puts
+	LDR	r0, [sp, #200]
+	BL	ul_trace_hex8
+	ADRL	r2, ul_sfx_h
+	BL	ul_trace_puts
+	LDR	r0, [sp, #204]
+	BL	ul_trace_hex8
+	MOV	r3, #10
+	STRB	r3, [r1], #1
+	SUB	r5, r1, r4		@ r5 = length of the line
+	MOV	r0, #0xC0
+	ADRL	r1, ul_trace_name
+	SWI	XOS_Find_T
+	BVS	ul_tr_done
+	MOVS	r6, r0			@ r6 = handle
+	BEQ	ul_tr_done
+	MOV	r0, #2
+	MOV	r1, r6
+	SWI	XOS_Args_T		@ r2 = extent
+	MOV	r0, #1
+	MOV	r1, r6
+	SWI	XOS_Args_T		@ pointer := extent
+	MOV	r0, #2
+	MOV	r1, r6
+	MOV	r2, r4
+	MOV	r3, r5
+	SWI	XOS_GBPB_T
+	MOV	r0, #0
+	MOV	r1, r6
+	SWI	XOS_Find_T		@ close
+ul_tr_done:
+	ADD	sp, sp, #208
+	MSR	APSR_nzcvq, r10
+	LDMFD	sp!, {r0-r12, pc}
+
+	@ r2 = NUL terminated string, r1 = write pointer: the string is copied without its NUL, r1 advanced; corrupts r2, r3
+ul_trace_puts:
+	LDRB	r3, [r2], #1
+	TEQ	r3, #0
+	STRBNE	r3, [r1], #1
+	BNE	ul_trace_puts
+	MOV	pc, lr
+
+	@ r0 = value, r1 = write pointer: 8 hex digits, r1 advanced; corrupts r0, r2, r3, r7
+ul_trace_hex8:
+	MOV	r7, #8
+ul_tr_hex_loop:
+	MOV	r0, r0, ROR #28
+	AND	r2, r0, #15
+	CMP	r2, #10
+	ADDLT	r2, r2, #'0'
+	ADDGE	r2, r2, #'A' - 10
+	STRB	r2, [r1], #1
+	SUBS	r7, r7, #1
+	BNE	ul_tr_hex_loop
+	MOV	pc, lr
+
+ul_trace_name:	.asciz	"LanMan98::MyShare.$.SulLog"
+ul_sfx_v:	.asciz	" v="
+ul_sfx_sp:	.asciz	" sp="
+ul_sfx_ctx:	.asciz	" ctx="
+ul_sfx_t:	.asciz	" t="
+ul_sfx_p:	.asciz	" p="
+ul_sfx_g:	.asciz	" g="
+ul_sfx_c:	.asciz	" c="
+ul_sfx_h:	.asciz	" h="
+	.align
+	.size	__ul_trace, . - __ul_trace
+#endif
+
 	.section ".bss"
 
 	.align
