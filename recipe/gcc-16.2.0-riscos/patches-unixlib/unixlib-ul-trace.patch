+#ifdef ULTRACE
+@ ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+@ ULTR (a debugging aid for test builds only: assemble with -DULTRACE; not part of the library): ULTR "text", reg  appends the line
+@     text v=<reg> sp=<the sp at the call> ctx=<VFPSupport_ActiveContext> t=<monotonic time> p=<[0x8038]> g=<[[0x8038]]> c=<[0x8040]> h=<sum of the words 0x8000-0x80FF>      (all in hex)
+@ p, g, c, h describe the application space at that moment: p is the word that PIC_LOAD reads (the runtime workspace: the pointer to the client's GOTT array), g what it points at (ffffffff when p cannot
+@ be read: OS_ValidateAddress says no), c SOManager's client structure of this application space, h a checksum of the first 256 bytes (ELF header and runtime workspace).
+@ to the SulLog file of the traced SharedUnixLibrary (the same file and format), with raw SWIs (OS_Find 0xC0 open for update, OS_Args 2 and 1 to go to the end, OS_GBPB 2, OS_Find 0 close), so that the
+@ last line survives a freeze.  __ul_trace (const char *text, unsigned value) is callable from C as well.  It preserves EVERY register and the flags, uses 264 bytes of the caller's stack (valid at
+@ every place it is called from) and no VFP/NEON instruction (the VFP context may be inactive there).  Must not be called while IRQs are off: the file write needs the network.
+@ ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
+	.macro	ULTR	text, reg=a1
+	STMFD	sp!, {r0, r1, lr}
+	MOV	r1, \reg
+	ADR	r0, 98f
+	BL	ul_trace_local
+	LDMFD	sp!, {r0, r1, lr}
+	B	99f
+98:	.asciz	"\text"
+	.align
+99:
+	.endm
+#else
+	.macro	ULTR	text, reg=a1
+	.endm
+#endif
+
 @ vfork is similar to fork.
 @
 @ fork makes a complete copy of the calling process's address space
@@ -88,6 +114,7 @@
 
