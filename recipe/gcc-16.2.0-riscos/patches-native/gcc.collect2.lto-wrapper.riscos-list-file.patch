 const char tool_name[] = "lto-wrapper";
 
+/* The list of the output files goes to stdout, unless the environment names a file for it: collect2 on RISC OS does that (see collect2.cc), because the
+   redirection of the stdout of a child process does not work there when the child starts processes itself.  */
+
+static FILE *
+list_stream (void)
+{
+  static FILE *stream;
+
+  if (!stream)
+    {
+      const char *name = getenv ("COLLECT_LTO_OUTPUT_LIST");
+
+      stream = stdout;
+      if (name && *name)
+	{
+	  stream = fopen (name, "w");
+	  if (!stream)
+	    fatal_error (input_location, "cannot open %s: %m", name);
+	}
+    }
+  return stream;
+}
