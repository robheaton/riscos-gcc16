diff -ruN a/ld/emulparams/armelf_riscos_eabi.sh b/ld/emulparams/armelf_riscos_eabi.sh
--- a/ld/emulparams/armelf_riscos_eabi.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/ld/emulparams/armelf_riscos_eabi.sh	2026-10-01 19:53:34.013907480 +0100
@@ -0,0 +1,35 @@
+# GCCSDK RISC OS EABI (arm-riscos-gnueabihf) emulation.
+ARCH=arm
+SCRIPT_NAME=elf
+OUTPUT_FORMAT="elf32-littlearm"
+BIG_OUTPUT_FORMAT="elf32-bigarm"
+LITTLE_OUTPUT_FORMAT="elf32-littlearm"
+
+# Makes elf.sc emit the RISC OS specific sections and Image$$... symbols.
+RISCOS_TARGET=yes
+
+TEXT_START_ADDR=0x8000
+MAXPAGESIZE=0x4
+COMMONPAGESIZE=0x4
+
+TEMPLATE_NAME=elf
+EXTRA_EM_FILE=armelf
+GENERATE_SHLIB_SCRIPT=yes
+
+TEXT_START_SYMBOLS='__text_start = . ;';
+DATA_START_SYMBOLS='__data_start = . ;';
+OTHER_TEXT_SECTIONS='*(.glue_7t) *(.glue_7) *(.riscos.libscl.chunkstub.start) *(SORT(.riscos.libscl.chunkstub.id*)) *(.riscos.libscl.chunkstub.end)'
+OTHER_BSS_SYMBOLS='__bss_start__ = .;'
+OTHER_BSS_END_SYMBOLS='_bss_end__ = . ; __bss_end__ = . ; __end__ = . ;'
+OTHER_SECTIONS='.note.gnu.arm.ident 0 : { KEEP (*(.note.gnu.arm.ident)) }'
+OTHER_READONLY_SECTIONS="
+  .ARM.extab ${RELOCATING-0} : { *(.ARM.extab${RELOCATING+* .gnu.linkonce.armextab.*}) }
+  ${RELOCATING+ PROVIDE_HIDDEN (__exidx_start = .); }
+  .ARM.exidx ${RELOCATING-0} : { *(.ARM.exidx${RELOCATING+* .gnu.linkonce.armexidx.*}) }
+  ${RELOCATING+ PROVIDE_HIDDEN (__exidx_end = .); }
+  .riscos.abi.version : { KEEP (*(.riscos.abi.version)) }"
+
+TARGET2_TYPE=got-rel
+
+# ARM does not support .s* sections.
+NO_SMALL_DATA=yes
