+/* Format a message.  With --throwback a message for stderr that has a source file and line is formatted into a temporary file first, then copied to FP, and the
+   text after the place goes to the editor as well.  (The nested calls for %pB and friends go straight to vfinfo_1.)  */
+
+void
+vfinfo (FILE *fp, const char *fmt, va_list ap, bool is_warning)
+{
+  static int depth;
+  FILE *tmp;
+  char *text;
+  long size;
+  size_t got;
+
+  if (depth > 0 || fp != stderr || !riscos_tb_enabled () || (tmp = tmpfile ()) == NULL)
+    {
+      depth++;
+      vfinfo_1 (fp, fmt, ap, is_warning);
+      depth--;
+      return;
+    }
+
+  free (riscos_tb_loc_file);
+  riscos_tb_loc_file = NULL;
+  riscos_tb_loc_line = 0;
+  riscos_tb_saw_x = 0;
+
+  depth++;
+  vfinfo_1 (tmp, fmt, ap, is_warning);
+  depth--;
+
+  size = ftell (tmp);
+  text = (size > 0) ? (char *) xmalloc (size + 1) : NULL;
+  if (text != NULL)
+    {
+      rewind (tmp);
+      got = fread (text, 1, size, tmp);
+      text[got] = '\0';
+      if (fwrite (text, 1, got, fp))
+	{
+	  /* Ignore.  */
+	}
+    }
+  fclose (tmp);
+
+  if (text != NULL && riscos_tb_loc_file != NULL)
+    {
+      /* The message is what follows "FILE:LINE:" in the text (the last line of it: "in function" lines come before).  */
+      char place[1100];
+      char *at, *msg;
+
+      snprintf (place, sizeof place, "%s:%u:", riscos_tb_loc_file, riscos_tb_loc_line);
+      at = strstr (text, place);
+      msg = at != NULL ? at + strlen (place) : text;
+      /* "(.text+0x1c): undefined reference to `foo'": the section and offset mean nothing to an editor.  */
+      if (*msg == '(')
+	{
+	  char *close = strstr (msg, "): ");
+
+	  if (close != NULL && close - msg < 80)
+	    msg = close + 3;
+	}
+      riscos_tb_report (riscos_tb_loc_file, (int) riscos_tb_loc_line,
+			riscos_tb_saw_x ? RISCOS_TB_ERROR : RISCOS_TB_WARNING, msg);
+    }
+  free (text);
+  free (riscos_tb_loc_file);
+  riscos_tb_loc_file = NULL;
+}
