--- a/include/riscos-throwback.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/riscos-throwback.h	2026-10-06 11:42:05.659027854 +0100
@@ -0,0 +1,489 @@
+/* riscos-throwback.h -- throwback of the errors and warnings of the assembler and the linker to a RISC OS text editor (--throwback).
+
+   Written for the GCCSDK GCC 16 forward port.  It does for gas and ld what riscos-throwback.cc (gcc/config/arm) does for the compilers: every diagnostic that has a source
+   file and a line is ALSO sent to the editor, which lists it in a throwback window from which the line can be opened.  The text on stderr does not change.  The idea, the SWI
+   protocol and the syslog protocol are those of the GCC 10 riscos.c by Nick Burrett, Alex Waugh and John Tytgat.
+
+   Two transports, chosen by the host the program is built for:
+
+   * built for RISC OS (__riscos__ is defined, as in the native binutils): the SWIs of the DDEUtils module, the way every RISC OS compiler and assembler does it.
+     DDEUtils_ThrowbackStart once, then for each message DDEUtils_ThrowbackSend (reason 0: "processing this file", whenever the file changes; reason 1: error or warning,
+     reason 2: information) and DDEUtils_ThrowbackEnd when the program ends.  The editor must have registered with DDEUtils (StrongED, Zap and !Edit do); if DDEUtils is not
+     loaded, or the program is not run in the desktop, or a SWI fails for any other reason, throwback is switched off silently for the rest of the run.
+   * built for another system (the cross binutils on Linux): one UDP datagram in syslog format per message, to the host named by the environment variable THROWBACK_HOST
+     (port 514, or THROWBACK_PORT).  The SysLogD module of the GCCSDK, running on the RISC OS machine, turns them into DDEUtils throwback.
+
+   Set THROWBACK_DEBUG (to anything) to see on stderr why throwback does not work.
+
+   Use: the program that has the option (--throwback) calls riscos_tb_enable ().  Where a diagnostic is printed, riscos_tb_report (file, line, severity, text) is called with
+   the file name as the program knows it (a Unix name or a RISC OS name), the line (0: not known), RISCOS_TB_* and the text of the message.  The functions are defined in ONE
+   source file of the program, which defines RISCOS_TB_IMPLEMENTATION before it includes this file; every other file only gets the declarations.
+
+   This file is part of GNU binutils (GPL version 3 or later, as the rest of the port).  */
+
+#ifndef RISCOS_THROWBACK_H
+#define RISCOS_THROWBACK_H
+
+/* The severities of DDEUtils.  */
+#define RISCOS_TB_INFORMATION (-1)
+#define RISCOS_TB_WARNING 0
+#define RISCOS_TB_ERROR 1
+#define RISCOS_TB_SERIOUS 2
+
+/* --throwback was given: report from now on.  */
+extern void riscos_tb_enable (void);
+/* Nonzero after riscos_tb_enable.  */
+extern int riscos_tb_enabled (void);
+/* A diagnostic at FILE:LINE of the given severity; TEXT is the message without the place and without "Error:" or "Warning:".  A FILE that is NULL or empty, or a pseudo file ("<stdin>", "<built-in>", "{standard input}"), is ignored: a name that has a path
+   variable in front ("<Obey$Dir>.s.bad") is a file.  */
+extern void riscos_tb_report (const char *file, int line, int severity, const char *text);
+
+#endif /* RISCOS_THROWBACK_H */
+
+#ifdef RISCOS_TB_IMPLEMENTATION
+#undef RISCOS_TB_IMPLEMENTATION
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <limits.h>
+#include <time.h>
+
+#ifdef __riscos__
+# define RISCOS_TB_NATIVE 1
+# include <kernel.h>
+# include <swis.h>
+# include <unixlib/local.h>
+#else
+# include <netdb.h>
+# include <netinet/in.h>
+# include <sys/socket.h>
+# include <sys/types.h>
+#endif
+
+/* The longest text that is sent in one message, and the most lines a diagnostic is allowed (more are cut off with "...").  DDEUtils puts the text into a Wimp message of at
+   most 256 bytes (the header and the line number and severity use 28 of them, and the text is cut off at 227 characters without a warning).  */
+#define RISCOS_TB_MAX_LINE 220
+#define RISCOS_TB_MAX_LINES 6
+#define RISCOS_TB_TEXT_MAX 4000
+
+static int riscos_tb_on;		/* --throwback was given */
+static int riscos_tb_state;		/* 0: nothing sent yet, 1: running, 2: switched off */
+
+void
+riscos_tb_enable (void)
+{
+  riscos_tb_on = 1;
+}
+
+int
+riscos_tb_enabled (void)
+{
+  return riscos_tb_on;
+}
+
+static int
+riscos_tb_debug_p (void)
+{
+  return getenv ("THROWBACK_DEBUG") != NULL;
+}
+
+/* Copy TEXT to BUF (N bytes) as plain ASCII: typographic quotes and dashes become what they look like, any other character that is not ASCII becomes '?', the control
+   characters become a space (DDEUtils ends the text at one) except the newline, which is kept.  Returns the length.  */
+static size_t
+riscos_tb_ascii (const char *text, char *buf, size_t n)
+{
+  const unsigned char *p = (const unsigned char *) text;
+  size_t o = 0;
+
+  while (*p && o + 4 < n)
+    {
+      unsigned char c = *p++;
+      unsigned long cp;
+      int extra, i;
+
+      if (c < 0x80)
+	{
+	  buf[o++] = (c == '\n' || (c >= 32 && c != 127)) ? (char) c : (c == 127 ? '?' : ' ');
+	  continue;
+	}
+
+      extra = (c >= 0xf0) ? 3 : (c >= 0xe0) ? 2 : (c >= 0xc0) ? 1 : 0;
+      cp = (extra == 3) ? (c & 0x07) : (extra == 2) ? (c & 0x0f) : (extra == 1) ? (c & 0x1f) : 0;
+      for (i = 0; i < extra && (*p & 0xc0) == 0x80; i++)
+	cp = (cp << 6) | (*p++ & 0x3f);
+
+      switch (cp)
+	{
+	case 0x2018: case 0x2019: case 0x201a: case 0x2032:
+	  buf[o++] = '\'';
+	  break;
+	case 0x201c: case 0x201d: case 0x201e: case 0x2033:
+	  buf[o++] = '"';
+	  break;
+	case 0x2010: case 0x2011: case 0x2012: case 0x2013: case 0x2014: case 0x2212:
+	  buf[o++] = '-';
+	  break;
+	case 0x2022:
+	  buf[o++] = '*';
+	  break;
+	case 0x2026:
+	  buf[o++] = '.'; buf[o++] = '.'; buf[o++] = '.';
+	  break;
+	case 0xa0:
+	  buf[o++] = ' ';
+	  break;
+	default:
+	  buf[o++] = '?';
+	  break;
+	}
+    }
+  buf[o] = '\0';
+  return o;
+}
+
+/* Cut the text of a diagnostic into the lines of throwback messages: at the newlines, and at the last space before RISCOS_TB_MAX_LINE characters; at most
+   RISCOS_TB_MAX_LINES of them.  Empty lines and the white space around the lines are dropped.  Returns the number of lines.  */
+static int
+riscos_tb_make_lines (const char *text, char lines[RISCOS_TB_MAX_LINES][RISCOS_TB_MAX_LINE + 4])
+{
+  char ascii[RISCOS_TB_TEXT_MAX + 8];
+  char *pos;
+  int count = 0, cut = 0;
+
+  riscos_tb_ascii (text, ascii, sizeof ascii);
+  pos = ascii;
+  while (*pos && !cut)
+    {
+      char *nl = strchr (pos, '\n');
+      char *line = pos;
+      char *end = nl ? nl : pos + strlen (pos);
+
+      pos = nl ? nl + 1 : end;
+      *end = '\0';
+
+      while (*line && !cut)
+	{
+	  size_t len, take;
+	  char *chunk_end;
+
+	  while (*line == ' ')
+	    line++;
+	  if (!*line)
+	    break;
+	  len = strlen (line);
+	  if (len > RISCOS_TB_MAX_LINE)
+	    {
+	      char *sp = line + RISCOS_TB_MAX_LINE;
+
+	      while (sp > line && *sp != ' ')
+		sp--;
+	      take = (sp == line || (size_t) (sp - line) < RISCOS_TB_MAX_LINE / 2) ? RISCOS_TB_MAX_LINE : (size_t) (sp - line);
+	    }
+	  else
+	    take = len;
+	  chunk_end = line + take;
+	  while (chunk_end > line && chunk_end[-1] == ' ')
+	    chunk_end--;
+	  if (chunk_end > line)
+	    {
+	      if (count == RISCOS_TB_MAX_LINES)
+		{
+		  cut = 1;
+		  break;
+		}
+	      memcpy (lines[count], line, chunk_end - line);
+	      lines[count][chunk_end - line] = '\0';
+	      count++;
+	    }
+	  line += take;
+	}
+    }
+
+  if (cut && count > 0)
+    {
+      size_t l = strlen (lines[count - 1]);
+
+      if (l + 3 > RISCOS_TB_MAX_LINE)
+	l = RISCOS_TB_MAX_LINE - 3;
+      strcpy (lines[count - 1] + l, "...");
+    }
+  return count;
+}
+
+#ifdef RISCOS_TB_NATIVE
+
+/* DDEUtils.  */
+static int riscos_tb_started;
+static int riscos_tb_have_file;
+static char riscos_tb_file[1024];	/* the file the editor was last told about, as the program calls it */
+static char riscos_tb_name[1100];	/* and its full RISC OS name */
+
+/* Call a SWI; the registers go in and out in REGS.  An error switches throwback off.  */
+static int
+riscos_tb_swi (int number, _kernel_swi_regs *regs)
+{
+  _kernel_oserror *err = _kernel_swi (number, regs, regs);
+
+  if (err)
+    {
+      if (riscos_tb_debug_p ())
+	fprintf (stderr, "throwback: SWI &%x failed: %s\n", (unsigned) number, err->errmess);
+      return 0;
+    }
+  return 1;
+}
+
+/* The full RISC OS name of FILE, which is a Unix style name (or a RISC OS one): the form of the name that the program used to open the file (__riscosify_std is what
+   open () uses), then OS_FSControl 37, which turns "@", "&", "%" and the special fields and path variables into the real thing.  The editor needs this because it does
+   not run in the directory of the program.  If a conversion does not work, the name goes on as far as it got.  */
+static void
+riscos_tb_riscos_name (const char *file, char *out, size_t n)
+{
+  char converted[1024];
+  _kernel_swi_regs r;
+
+  if (!__riscosify_std (file, 0, converted, sizeof converted, NULL))
+    {
+      snprintf (out, n, "%s", file);
+      return;
+    }
+
+  memset (&r, 0, sizeof r);
+  r.r[0] = 37;
+  r.r[1] = (int) converted;
+  r.r[2] = (int) out;
+  r.r[5] = (int) n;
+  if (_kernel_swi (OS_FSControl, &r, &r) || r.r[5] < 0)
+    snprintf (out, n, "%s", converted);
+}
+
+static int
+riscos_tb_start (void)
+{
+  _kernel_swi_regs r;
+
+  memset (&r, 0, sizeof r);
+  riscos_tb_started = riscos_tb_swi (DDEUtils_ThrowbackStart, &r);
+  return riscos_tb_started;
+}
+
+static int
+riscos_tb_send (const char *file, int line, int severity, const char *text)
+{
+  _kernel_swi_regs r;
+
+  if (!riscos_tb_have_file || strcmp (file, riscos_tb_file) != 0)
+    {
+      riscos_tb_riscos_name (file, riscos_tb_name, sizeof riscos_tb_name);
+      snprintf (riscos_tb_file, sizeof riscos_tb_file, "%s", file);
+      riscos_tb_have_file = 1;
+
+      memset (&r, 0, sizeof r);
+      r.r[0] = 0;				/* processing this file */
+      r.r[2] = (int) riscos_tb_name;
+      if (!riscos_tb_swi (DDEUtils_ThrowbackSend, &r))
+	return 0;
+    }
+
+  memset (&r, 0, sizeof r);
+  r.r[0] = (severity == RISCOS_TB_INFORMATION) ? 2 : 1;	/* information / error details */
+  r.r[1] = 0;
+  r.r[2] = (int) riscos_tb_name;
+  r.r[3] = line;
+  r.r[4] = (severity == RISCOS_TB_INFORMATION) ? 0 : severity;
+  r.r[5] = (int) text;
+  return riscos_tb_swi (DDEUtils_ThrowbackSend, &r);
+}
+
+static void
+riscos_tb_finish (void)
+{
+  if (riscos_tb_started)
+    {
+      _kernel_swi_regs r;
+
+      memset (&r, 0, sizeof r);
+      riscos_tb_swi (DDEUtils_ThrowbackEnd, &r);
+      riscos_tb_started = 0;
+    }
+}
+
+#else /* not RISC OS: the syslog transport */
+
+/* The syslog priorities (facility user) of the messages that SysLogD turns into throwback.  */
+#define RISCOS_TB_PRI_SERIOUS (1 * 8 + 3)
+#define RISCOS_TB_PRI_WARNING (1 * 8 + 4)
+#define RISCOS_TB_PRI_INFORMATION (1 * 8 + 6)
+
+static int riscos_tb_socket = -1;
+static char riscos_tb_hostname[100];
+
+static void
+riscos_tb_finish (void)
+{
+  if (riscos_tb_socket >= 0)
+    {
+      close (riscos_tb_socket);
+      riscos_tb_socket = -1;
+    }
+}
+
+static int
+riscos_tb_start (void)
+{
+  const char *host = getenv ("THROWBACK_HOST");
+  const char *portenv = getenv ("THROWBACK_PORT");
+  struct hostent *hp;
+  struct servent *serv;
+  struct sockaddr_in name;
+  int port = 514;
+
+  if (host == NULL)
+    {
+      if (riscos_tb_debug_p ())
+	fprintf (stderr, "throwback: THROWBACK_HOST is not set\n");
+      return 0;
+    }
+
+  hp = gethostbyname (host);
+  if (hp == NULL || hp->h_addrtype != AF_INET || hp->h_length != (int) sizeof (struct in_addr))
+    {
+      if (riscos_tb_debug_p ())
+	fprintf (stderr, "throwback: cannot find the host %s\n", host);
+      return 0;
+    }
+
+  if (portenv)
+    port = atoi (portenv);
+  else if ((serv = getservbyname ("syslog", "udp")) != NULL)
+    port = ntohs (serv->s_port);
+
+  memset (&name, 0, sizeof name);
+  memcpy (&name.sin_addr, hp->h_addr_list[0], hp->h_length);
+  name.sin_family = AF_INET;
+  name.sin_port = htons (port);
+
+  riscos_tb_socket = socket (AF_INET, SOCK_DGRAM, 0);
+  if (riscos_tb_socket < 0 || connect (riscos_tb_socket, (struct sockaddr *) &name, sizeof name) < 0)
+    {
+      if (riscos_tb_debug_p ())
+	fprintf (stderr, "throwback: cannot open a socket to %s port %d\n", host, port);
+      riscos_tb_finish ();
+      return 0;
+    }
+
+  if (gethostname (riscos_tb_hostname, sizeof riscos_tb_hostname) < 0)
+    strcpy (riscos_tb_hostname, "unknown");
+  riscos_tb_hostname[sizeof riscos_tb_hostname - 1] = '\0';
+  return 1;
+}
+
+static int
+riscos_tb_send (const char *file, int line, int severity, const char *text)
+{
+  char path[PATH_MAX];
+  char stamp[20];
+  char msg[1100 + PATH_MAX];
+  time_t now = time (NULL);
+  struct tm tmbuf;
+  int pri, n;
+
+  if (riscos_tb_socket < 0)
+    return 0;
+
+  if (realpath (file, path) == NULL)
+    snprintf (path, sizeof path, "%s", file);
+
+  if (localtime_r (&now, &tmbuf) == NULL || strftime (stamp, sizeof stamp, "%b %e %H:%M:%S", &tmbuf) == 0)
+    strcpy (stamp, "Jan  1 00:00:00");
+
+  pri = (severity == RISCOS_TB_INFORMATION) ? RISCOS_TB_PRI_INFORMATION
+	: (severity == RISCOS_TB_WARNING) ? RISCOS_TB_PRI_WARNING : RISCOS_TB_PRI_SERIOUS;
+
+  /* <PRI>Mmm dd hh:mm:ss host throwback FILE:LINE: TEXT  -- what SysLogD looks for.  A ':' in the file name would end it early there, as it does for the old compiler.  */
+  n = snprintf (msg, sizeof msg, "<%d>%s %s throwback %s:%d: %s", pri, stamp, riscos_tb_hostname, path, line, text);
+  if (n < 0)
+    return 0;
+  if (n > 1000)
+    n = 1000;
+
+  if (send (riscos_tb_socket, msg, n, 0) < 0)
+    {
+      if (riscos_tb_debug_p ())
+	fprintf (stderr, "throwback: the datagram could not be sent\n");
+      return 0;
+    }
+  return 1;
+}
+
+#endif /* RISCOS_TB_NATIVE */
+
+static void
+riscos_tb_at_exit (void)
+{
+  if (riscos_tb_state == 1)
+    {
+      riscos_tb_finish ();
+      riscos_tb_state = 2;
+    }
+}
+
+/* "<stdin>", "<built-in>", "<command-line>" and gas's "{standard input}" are not files; "<Obey$Dir>.s.bad" is a file with a path variable in front.  */
+static int
+riscos_tb_not_a_file (const char *file)
+{
+  const char *gt;
+
+  if (file == NULL || file[0] == '\0' || file[0] == '{')
+    return 1;
+  if (file[0] != '<')
+    return 0;
+  gt = strchr (file, '>');
+  return gt == NULL || gt[1] == '\0';
+}
+
+void
+riscos_tb_report (const char *file, int line, int severity, const char *text)
+{
+  char lines[RISCOS_TB_MAX_LINES][RISCOS_TB_MAX_LINE + 4];
+  int count, i;
+
+  if (!riscos_tb_on || riscos_tb_state == 2)
+    return;
+
+  /* Locations that are not files.  */
+  if (riscos_tb_not_a_file (file))
+    return;
+
+  if (riscos_tb_state == 0)
+    {
+      if (!riscos_tb_start ())
+	{
+	  riscos_tb_state = 2;
+	  return;
+	}
+      riscos_tb_state = 1;
+      atexit (riscos_tb_at_exit);
+    }
+
+  count = riscos_tb_make_lines (text ? text : "", lines);
+  if (count == 0)
+    {
+      strcpy (lines[0], "(no text)");
+      count = 1;
+    }
+
+  if (line < 1)
+    line = 0;
+  for (i = 0; i < count; i++)
+    /* The first line has the severity of the diagnostic; what follows is more of the same message.  */
+    if (!riscos_tb_send (file, line, i == 0 ? severity : RISCOS_TB_INFORMATION, lines[i]))
+      {
+	riscos_tb_state = 2;
+	return;
+      }
+}
+
+#endif /* RISCOS_TB_IMPLEMENTATION */
