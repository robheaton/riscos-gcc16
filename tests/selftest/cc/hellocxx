#include <future>
#include <iostream>
#include <stdexcept>
#include <string>
#include <thread>
#include <vector>

int main ()
{
  int failures = 0;
  std::vector<std::string> v { "hello", "from", "C++" };
  try { throw std::runtime_error ("an exception"); }
  catch (const std::exception &e) { if (std::string (e.what ()) != "an exception") failures++; v.push_back (e.what ()); }
  std::thread t ([&] { v.push_back ("a thread"); });
  t.join ();
  auto f = std::async (std::launch::async, [] { return 6 * 7; });
  if (f.get () != 42) failures++;
  if (v.size () != 5) failures++;
  for (const auto &s : v) std::cout << s << ", ";
  std::cout << "done\n";
  return failures;
}
