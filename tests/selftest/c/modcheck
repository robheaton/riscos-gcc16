/* modcheck -- checks the files of check 12 of the self-test (a module that gcc -mmodule made).

     modcheck module FILE [TITLE [COMMAND]]   FILE is a module image: not an ELF file, the words of the module header point inside the file, the title is TITLE (default ModHello), the help
                                 string starts with it, the first command of the command table is COMMAND (default ModHello_Sum), and the relocation table is right: it ends the file, and every
                                 word that it lists holds an address inside the image (a module with a wrong table crashes the machine when it is loaded: this is checked BEFORE RMLoad)
     modcheck same FILE1 FILE2   the two files are identical
     modcheck text FILE WORD     the first word of the text file FILE is WORD
   It says what it found and returns 0 when all of it is right (2 when FILE is not there).  */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>

static unsigned char *slurp (const char *path, size_t *len)
{
  FILE *f = fopen (path, "rb");
  unsigned char *d;
  size_t n = 0, cap = 4096, r;
  if (!f) return NULL;
  d = malloc (cap + 1);
  while (d && (r = fread (d + n, 1, cap - n, f)) > 0)
    {
      n += r;
      if (n == cap) { cap *= 2; d = realloc (d, cap + 1); }
    }
  fclose (f);
  if (!d) return NULL;
  d[n] = 0;
  *len = n;
  return d;
}

static unsigned word (const unsigned char *d, size_t off) { return d[off] | d[off + 1] << 8 | d[off + 2] << 16 | (unsigned) d[off + 3] << 24; }

int main (int argc, char **argv)
{
  size_t len;
  unsigned char *d;
  if (argc < 3) { puts ("usage: modcheck module FILE [TITLE [COMMAND]] | modcheck same FILE1 FILE2 | modcheck text FILE WORD"); return 1; }
  d = slurp (argv[2], &len);
  if (!d) { printf ("modcheck: cannot read %s\n", argv[2]); return 2; }
  if (strcmp (argv[1], "text") == 0 && argc == 4)
    {
      char *p = (char *) d;
      char *w, *e;
      while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
      w = p;
      e = w;
      while (*e && *e != ' ' && *e != '\t' && *e != '\n' && *e != '\r') e++;
      *e = 0;
      printf ("modcheck: the first word of %s is '%s' (expected '%s')\n", argv[2], w, argv[3]);
      return strcmp (w, argv[3]) == 0 ? 0 : 1;
    }
  if (strcmp (argv[1], "same") == 0 && argc == 4)
    {
      size_t len2;
      unsigned char *d2 = slurp (argv[3], &len2);
      if (!d2) { printf ("modcheck: cannot read %s\n", argv[3]); return 2; }
      printf ("modcheck: %s is %lu bytes, %s is %lu bytes: %s\n", argv[2], (unsigned long) len, argv[3], (unsigned long) len2, len == len2 && memcmp (d, d2, len) == 0 ? "identical" : "DIFFERENT");
      return len == len2 && memcmp (d, d2, len) == 0 ? 0 : 1;
    }
  if (strcmp (argv[1], "module") == 0)
    {
      int ok = 1;
      const char *want_title = argc > 3 ? argv[3] : "ModHello", *want_cmd = argc > 4 ? argv[4] : "ModHello_Sum";
      unsigned title, help, cmdtab, init, fin, flags, tab, count, i;
      if (len < 56 || len % 4) { printf ("modcheck: %s is %lu bytes: not a module image\n", argv[2], (unsigned long) len); return 1; }
      if (memcmp (d, "\177ELF", 4) == 0) { printf ("modcheck: %s is still an ELF file: the post-link step did not run\n", argv[2]); return 1; }
      init = word (d, 4); fin = word (d, 8); title = word (d, 16); help = word (d, 20); cmdtab = word (d, 24); flags = word (d, 48);
      printf ("modcheck: %lu bytes, start %u, init %u, final %u, title %u, help %u, commands %u, flags word at %u\n", (unsigned long) len, word (d, 0), init, fin, title, help, cmdtab, flags);
      if (word (d, 0) != 0 || init >= len || fin >= len || title >= len || help >= len || cmdtab >= len || flags + 16 > len || flags % 4) { printf ("modcheck: the header words do not point into the file\n"); return 1; }
      if (strcmp ((char *) d + title, want_title) != 0) { printf ("modcheck: the title is '%s', not '%s'\n", d + title, want_title); ok = 0; }
      if (ok && strncmp ((char *) d + help, want_title, strlen (want_title)) != 0) { printf ("modcheck: the help string is '%s'\n", d + help); ok = 0; }
      if (ok && strcasecmp ((char *) d + cmdtab, want_cmd) != 0) { printf ("modcheck: the first command is '%s', not '%s'\n", d + cmdtab, want_cmd); ok = 0; }
      /* after the flags word: link_addr (0), then reloc_info: the offset of the table and the number of entries; the table is the end of the file */
      if (ok && word (d, flags) != 1) { printf ("modcheck: the flags word is %u\n", word (d, flags)); ok = 0; }
      if (ok && word (d, flags + 4) != 0) { printf ("modcheck: the linked address is %u, not 0\n", word (d, flags + 4)); ok = 0; }
      if (ok)
        {
          tab = word (d, flags + 8); count = word (d, flags + 12);
          printf ("modcheck: relocation table at %u, %u entries\n", tab, count);
          if (tab % 4 || tab > len || (size_t) tab + 4 * (size_t) count != len || count == 0) { printf ("modcheck: the relocation table does not end the file\n"); ok = 0; }
          for (i = 0; ok && i < count; i++)
            {
              unsigned off = word (d, tab + 4 * i);
              if (off % 4 || off + 4 > tab) { printf ("modcheck: entry %u of the table is %u: outside the image\n", i, off); ok = 0; }
              else if (word (d, off) > tab) { printf ("modcheck: entry %u: the word at %u holds %u, which is not an address in the image\n", i, off, word (d, off)); ok = 0; }
            }
        }
      return ok ? 0 : 1;
    }
  puts ("usage: modcheck module FILE [TITLE [COMMAND]] | modcheck same FILE1 FILE2 | modcheck text FILE WORD");
  return 1;
}
