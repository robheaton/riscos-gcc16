; CmhgD / CmhgE: swi-decoding-code on the machine.  CmhgD has one function (it gets the registers), CmhgE two (the name to number one and the number to name one); no table of names.
; (pack/module42; the same C file, cmhgd.c, with -DPAIR for CmhgE)
title-string:           CmhgD
help-string:            CmhgD 1.00
date-string:            10 Oct 2026

initialisation-code:    cd_init
swi-chunk-base-number:  0x58E00
swi-handler-code:       cd_swi
swi-decoding-code:      cd_dec

command-keyword-table: cd_table
  CmhgD_Test(min-args: 0, max-args: 0, help-text: "*CmhgD_Test asks the kernel for the names of the module's SWIs.\n", invalid-syntax: "Syntax: *CmhgD_Test")
