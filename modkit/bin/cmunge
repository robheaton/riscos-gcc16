#!/usr/bin/env python3
"""cmunge - a CMunge-compatible command line for the modules of modkit (GCC 16 EABI, no C library).

  cmunge [-tgcc] [-32bit] [-p|-px] [-D<sym>[=<val>]] [-U<sym>] [-I<dir>] [-throwback] [-s FILE.s] [-d FILE.h] [-o FILE.o] [-xh FILE.h] [-xhdr FILE.hdr] [-zbase] [-zoslib] [-zerrors] [-depend FILE] FILE.cmhg

The command line of GCCSDK's CMunge 0.xx (what its makefiles use: cmunge -tgcc -32bit -p -d header.h -o header.o file.cmhg), with the work done by mkmodhdr.py:
  -o FILE   the object: the generated assembler source assembled for ARMv6 (arm-riscos-gnueabihf-gcc, the one next to this script or on PATH; CMUNGE_CC overrides it)
  -s FILE   the generated assembler source (kept)          -d FILE   the C header (Module_Title, CMD_<name>, ... and the prototypes of your handlers)
  -p, -px   run the C preprocessor over the file first (-D, -U and -I go to it); the included files are processed as part of the text in both modes
  -zbase    Image__RO_Base: a constant that holds Image$$RO$$Base, declared in the header (GCCSDK 4.7.4's CMunge; its examples use it); -zoslib, -zerrors, -xh FILE and -xhdr FILE as CMunge has them
  -depend FILE  accepted with CMunge's warning that GCC has no such flag (no file is written)
Accepted and without effect, because the model has nothing to switch: -tgcc, -32bit, -znoscl, -throwback, -cmhg, and -apcs 3/<flags> when the flags only choose a calling convention that the model has one of
anyway (nofpregargs, fpregargs, nofp, fpe3, swst, noswst, nonreent).  Everything else that CMunge has (-tnorcroft, -tlcc, -26bit, -apcs 26|reent|pic, -blank, any other -t, -x or -z) is refused with a message instead of being ignored: a module that needs it would be built wrong.
What of the CMHG language is supported: bin/mkmodhdr.py.  The RISC OS numbers come from the RISC OS Open sources: set RISCOS_SOURCES to a checkout (see modkit/README.md)."""
import os, shutil, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.realpath(__file__))        # where mkmodhdr.py is (also when this is called through the link <tc>/bin/cmunge)
BINDIR = os.path.dirname(os.path.abspath(__file__))        # the folder it was called from: <tc>/bin when it is the link
NOOP = {"-tgcc", "-32bit", "-znoscl", "-throwback", "-cmhg"}
REFUSED = {"-tnorcroft": "the Norcroft toolchain", "-tlcc": "the LCC toolchain", "-26bit": "26 bit code", "-blank": "-blank", "-h": None}


def die(msg):
    sys.stderr.write("cmunge: %s\n" % msg)
    sys.exit(1)


def find_cc():
    cc = os.environ.get("CMUNGE_CC")
    if cc:
        return cc
    for c in (os.path.join(BINDIR, "arm-riscos-gnueabihf-gcc"), os.path.join(HERE, "..", "..", "..", "bin", "arm-riscos-gnueabihf-gcc"), shutil.which("arm-riscos-gnueabihf-gcc"), os.path.expanduser("~/gccsdk-next/env-f/bin/arm-riscos-gnueabihf-gcc")):
        if c and os.path.exists(c):
            return c
    die("no arm-riscos-gnueabihf-gcc: put it on PATH or set CMUNGE_CC")


# CMunge's own table of the -apcs flags (apcscli.c): a flag is the name or an abbreviation of at least MIN letters ("nofpr" is nofpregargs, "noswst" noswstackcheck, "nonreent" nonreentrant)
APCS_FLAGS = (("32bit", 2, True), ("26bit", 2, False), ("reentrant", 5, False), ("nonreentrant", 8, True), ("fpe3", 4, True), ("fpe2", 4, True), ("swstackcheck", 4, True), ("noswstackcheck", 6, True),
              ("fpregargs", 3, True), ("nofpregargs", 5, True), ("fp", 2, True), ("nofp", 4, True))


def check_apcs(spec):
    """-apcs 3/nofpregargs and the like: accepted and ignored when the flags only choose a calling convention that the model has one of anyway; APCS-26 and reentrant (PIC) modules are refused"""
    toks = spec.split("/")
    if toks[0] not in ("3", "32"):
        die("-apcs %s: only APCS-32 (3/...) is supported" % spec)
    for tok in toks[1:]:
        if tok == "32":
            continue
        if tok == "pic":
            die("-apcs %s: reentrant (position independent) modules are not supported: the module relocates itself" % spec)
        for name, minlen, ok in APCS_FLAGS:
            if len(tok) >= minlen and name.startswith(tok):
                if not ok:
                    die("-apcs %s: %s code is not supported by the modkit version of cmunge" % (spec, "26 bit" if name == "26bit" else "reentrant (position independent)"))
                break
        else:
            die("-apcs %s: the flag %s is not known to the modkit version of cmunge" % (spec, tok))


def main(argv):
    out_o = out_s = out_h = infile = None
    pre = False
    base = False
    zoslib = zerrors = False
    xh = xhdr = None
    cpp = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in NOOP:
            pass
        elif a == "-zbase":
            base = True                                                      # Image__RO_Base: the address of the module (a word in the module, and extern const int Image__RO_Base in the header)
        elif a == "-apcs":
            i += 1
            if i >= len(argv):
                die("-apcs needs a specification such as 3/nofpregargs")
            check_apcs(argv[i])
        elif a == "-zoslib":
            zoslib = True                                                    # OSLib's types in the header (os_error, os_register_block, #include "oslib/os.h")
        elif a == "-zerrors":
            zerrors = True                                                   # the error blocks of error-identifiers: only, for an application
        elif a in ("-xh", "-xhdr", "-depend"):
            i += 1
            if i >= len(argv):
                die("%s needs a file name" % a)
            if a == "-xh": xh = argv[i]                                      # the SWI numbers as a C header
            elif a == "-xhdr": xhdr = argv[i]                                # ... and for the assembler
            else: sys.stderr.write("Warning: GCC has no support for -depend flag\n")       # (as CMunge's: the file is not written)
        elif a in ("-o", "-s", "-d"):
            i += 1
            if i >= len(argv):
                die("%s needs a file name" % a)
            if a == "-o": out_o = argv[i]
            elif a == "-s": out_s = argv[i]
            else: out_h = argv[i]
        elif a in ("-p", "-px"):
            pre = True
        elif a[:2] in ("-D", "-U", "-I") and len(a) > 2:
            cpp.append(a)
        elif a in ("-D", "-U", "-I"):
            i += 1
            cpp.append(a + argv[i] if i < len(argv) else die("%s needs an argument" % a))
        elif a in REFUSED:
            if a == "-h":
                print(__doc__); return 0
            die("%s is not supported by the modkit version of cmunge" % (REFUSED[a] or a))
        elif a.startswith("-x") or a.startswith("-t") or a.startswith("-z"):
            die("%s is not supported by the modkit version of cmunge" % a)
        elif a.startswith("-"):
            die("unknown option %s (cmunge -h)" % a)
        elif infile is None:
            infile = a
        else:
            die("more than one input file: %s and %s" % (infile, a))
        i += 1
    if infile is None:
        die("no input file (cmunge -h)")
    if not (out_o or out_s or out_h or xh or xhdr):
        die("nothing to do: give -o, -s or -d")
    tmp = tempfile.mkdtemp(prefix="cmunge-")
    try:
        src = infile
        if pre:
            src = os.path.join(tmp, os.path.basename(infile))
            # assembler-with-cpp: the preprocessor does not choke on the apostrophes of the ';' comments
            r = subprocess.run([find_cc(), "-E", "-P", "-x", "assembler-with-cpp"] + cpp + [infile], capture_output=True)
            if r.returncode:
                sys.stderr.write(r.stderr.decode("latin-1")); die("the preprocessor failed on %s" % infile)
            open(src, "wb").write(r.stdout)                                  # bytes: the files are RISC OS text (Latin-1), not UTF-8
        asm = out_s or os.path.join(tmp, "module.s")
        cmd = [sys.executable, os.path.join(HERE, "mkmodhdr.py"), "-s", asm] + (["--base"] if base else []) + (["--zoslib"] if zoslib else []) + (["--zerrors"] if zerrors else []) + (["--xh", xh] if xh else []) + (["--xhdr", xhdr] if xhdr else [])
        if out_h:
            cmd += ["-d", out_h]
        cmd.append(src)
        r = subprocess.run(cmd)
        if r.returncode:
            return r.returncode
        if out_o:
            r = subprocess.run([find_cc(), "-march=armv6", "-c", asm, "-o", out_o])
            if r.returncode:
                return r.returncode
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0


sys.exit(main(sys.argv[1:]))
