echo "[test and arithmetic]"
[ 1 -eq 1 ] && echo eq
[ 1 -ne 2 ] && echo ne
[ 3 -gt 2 ] && [ 2 -ge 2 ] && [ 1 -lt 2 ] && [ 2 -le 2 ] && echo cmp
[ "a" = "a" ] && [ "a" != "b" ] && echo streq
[ -z "" ] && [ -n "x" ] && echo zn
[ ! -z x ] && echo notz
[ -f /nonexistent ] || echo nofile
[ -d . ] && echo dir
[ -e . ] && echo exists
[ \( 1 -eq 1 \) -a \( 2 -eq 2 \) ] && echo andgroup
[ 1 -eq 2 -o 3 -eq 3 ] && echo or
test "x$unset" = "x" && echo unsetempty
[ "a b" = "a b" ] && echo spaces
[ -n "$undefined_zzz" ] || echo undefinedempty
[ 1 = 1 ] && echo numstr
[ "" ] || echo emptyfalse
[ "x" ] && echo nonemptytrue
[ ] || echo noargs
[ a ] && echo oneargtrue
echo $((1+1)) $((2*3)) $((7/2)) $((7%2)) $((1<<3)) $((16>>2)) $((5&3)) $((5|3)) $((5^3)) $((~0)) $((!0)) $((!1))
echo $((1==1)) $((1!=1)) $((2>1)) $((2<1)) $((2>=2)) $((1<=0)) $((1&&0)) $((1||0))
i=5; echo $((i+1)) $((i*i)) $((i-10))
i=$((i+1)); echo $i
echo $((010)) $((0x10))
echo $((1 ? 2 : 3)) $((0 ? 2 : 3))
x=3; echo $((x > 2 && x < 5))
exit 0
