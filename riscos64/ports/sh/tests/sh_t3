# new in the shell: [[ ]], ${v/p/r}, ${v:o:l}, ${v^^} ${v,,}, $'..', set -o pipefail
v="Hello World, hello"
echo "${v/ello/ELLO}"
echo "${v//ello/ELLO}"
echo "${v/#Hello/Bye}"
echo "${v/%hello/bye}"
echo "${v/#World/no}"
echo "${v//o/}"
echo "${v//[eo]/_}"
echo "${v:6}"
echo "${v:6:5}"
echo "${v: -5}"
echo "${v: -5:3}"
echo "${v:0:5}x"
echo "${v^^}"
echo "${v,,}"
echo "${v^}"
w=abc
echo "${w^}"
echo "${w^^}${w^}"
printf '%s\n' $'tab\there' $'nl\\n' $'q\'q' $'\x41\101\e[0m' | od -c | head -5
if [[ $v == Hello* ]]; then echo glob-yes; else echo glob-no; fi
if [[ $v == hello* ]]; then echo glob-yes; else echo glob-no; fi
if [[ $v != *xyz ]]; then echo ne-yes; fi
[[ -n $v && -z "" ]] && echo and-ok
[[ -z $v || $w = abc ]] && echo or-ok
[[ ! -e /nonexistent_zzz ]] && echo not-ok
[[ ( $w == abc ) && ( 1 -lt 2 ) ]] && echo paren-ok
