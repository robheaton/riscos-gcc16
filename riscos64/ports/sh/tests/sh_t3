[[ $v =~ ^Hello\ W[a-z]+ ]] && echo re-ok
[[ $v =~ ^xyz ]] || echo re-no
e="a b"
[[ $e == "a b" ]] && echo nosplit-ok
[[ $e == a* ]] && echo pat-ok
[[ $e == "a*" ]] || echo quoted-no
[[ -f ./sh_t3 || -d . ]] && echo file-ok
[[ -n "" ]]; echo rc=$?
[[ x ]]; echo rc=$?
false | true; echo "nopipefail rc=$?"
set -o pipefail
false | true; echo "pipefail rc=$?"
true | false | true; echo "pipefail2 rc=$?"
