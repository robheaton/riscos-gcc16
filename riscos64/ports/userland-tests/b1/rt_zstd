fails=0
for f in orig bin zero mixed; do
  for lv in 1 3 9; do
    zstd -q -$lv -f $f -o t.zst && zstd -q -d -f t.zst -o t.out && cmp $f t.out || { echo "FAIL zstd -$lv $f"; fails=$((fails+1)); }
  done
  zstd -q -T1 -c -3 $f | zstd -q -d -c > t.out && cmp $f t.out || { echo "FAIL zstd pipe $f"; fails=$((fails+1)); }
  echo "done $f"
done
echo "zstd round trips done: $fails failures"
