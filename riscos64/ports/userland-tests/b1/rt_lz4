fails=0
for f in orig bin zero mixed; do
  for lv in 1 3 9; do
    lz4 -$lv -f $f t.lz4 >/dev/null 2>&1 && lz4 -d -f t.lz4 t.out >/dev/null 2>&1 && cmp $f t.out || { echo "FAIL lz4 -$lv $f"; fails=$((fails+1)); }
  done
  lz4 -B4 -BD -f $f t.lz4 >/dev/null 2>&1 && lz4 -d -f t.lz4 t.out >/dev/null 2>&1 && cmp $f t.out || { echo "FAIL lz4 dependent blocks $f"; fails=$((fails+1)); }
  lz4 --fast=5 -f $f t.lz4 >/dev/null 2>&1 && lz4 -d -f t.lz4 t.out >/dev/null 2>&1 && cmp $f t.out || { echo "FAIL lz4 fast $f"; fails=$((fails+1)); }
  echo "done $f"
done
echo "lz4 round trips done: $fails failures"
